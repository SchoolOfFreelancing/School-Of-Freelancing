DirectoryIndex index.html index.htm index.php

Options -Indexes

# ==============================================================================
# ENCODING & MIME-TYPES
# ==============================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .json .xml

<IfModule mod_headers.c>
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ==============================================================================
    # 1. FIX CANONICAL & DUPLICATE URL ISSUES
    # ==============================================================================

    # Force HTTPS on Live Server (Cloudflare/CWP) while EXCLUDING localhost
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Remove www (force non-www)
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Redirect external requests for /index.html directly to root /
    # Uses %{ENV:REDIRECT_STATUS} ^$ to ensure INTERNAL rewrites are ignored (Prevents 503 Loop)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

    # Remove trailing slashes from non-directory requests
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Direct 301 redirect if someone explicitly requests .html extensions (excluding index.html)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/ [NC]
    RewriteCond %1 !^index$ [NC]
    RewriteRule ^([^/]+)\.html$ /%1 [R=301,L]

    # ==============================================================================
    # 2. ROUTING & SLUG HANDLING
    # ==============================================================================

    # Serve existing files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Extensionless HTML slug routing (e.g. /about maps to about.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Fallback to index.html for Single Page Applications / Unmapped paths
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# 3. CUSTOM ERROR PAGES
# ==============================================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# 4. ROBOTS & CRAWLER HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    Header set X-Robots-Tag "index, follow"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ==============================================================================
# 5. GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
