DirectorySlash Off

DirectoryIndex index.html index.htm index.php

Options -Indexes

# ==============================================================================
# ENCODING & MIME-TYPES
# ==============================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .json .xml

<IfModule mod_headers.c>

    # Plain-text files
    <FilesMatch "\.txt$">
        Header always set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>

    # --------------------------------------------------------------------------
    # Agent authentication document
    # --------------------------------------------------------------------------
    <Files "auth.md">
        Header always set Content-Type "text/markdown; charset=utf-8"
    </Files>

    # --------------------------------------------------------------------------
    # Extensionless OAuth metadata endpoints
    # --------------------------------------------------------------------------
    <Files "oauth-authorization-server">
        Header always set Content-Type "application/json; charset=utf-8"
    </Files>

    <Files "oauth-protected-resource">
        Header always set Content-Type "application/json; charset=utf-8"
    </Files>

    <Files "mcp">
        Header always set Content-Type "application/json; charset=utf-8"
    </Files>

</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==============================================================================
    # 1. FIX CANONICAL & DUPLICATE URL ISSUES
    # ==============================================================================
    # HTTPS forcing and www removal are handled at the Cloudflare edge.

    # ------------------------------------------------------------------------------
    # Redirect explicit /index.html requests to the directory root
    # ------------------------------------------------------------------------------
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html(?:[?\s]) [NC]
    RewriteRule ^(.*)index\.html$ $1 [R=301,L]

    # ------------------------------------------------------------------------------
    # Remove trailing slash from non-directory requests
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # ------------------------------------------------------------------------------
    # Remove explicit .html extension
    # Excludes index.html because it is handled separately above.
    # ------------------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^/]+)\.html(?:[?\s]) [NC]
    RewriteCond %2 !^index$ [NC]
    RewriteRule ^(.*)\.html$ $1 [R=301,L]

    # ==============================================================================
    # 2. ROUTING & SLUG HANDLING
    # ==============================================================================

    # ------------------------------------------------------------------------------
    # Serve existing files and directories directly
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------------------
    # Extensionless HTML slug routing
    # Supports nested paths such as /legal/terms
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)/?$ $1.html [L]

    # ------------------------------------------------------------------------------
    # NOTE:
    # No SPA/index.html fallback.
    #
    # This site uses server-side slug -> .html mapping.
    # Unmapped paths therefore return a genuine 404.
    # ------------------------------------------------------------------------------

</IfModule>

# ==============================================================================
# 3. CUSTOM ERROR PAGES
# ==============================================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# 4. ROBOTS, SECURITY & AGENT DISCOVERY HEADERS
# ==============================================================================
<IfModule mod_headers.c>

    # Tell search engines that normal HTML pages are indexable.
    <FilesMatch "\.(html|htm)$">
        Header always set X-Robots-Tag "index, follow"
    </FilesMatch>

    # Prevent MIME-type sniffing.
    Header always set X-Content-Type-Options "nosniff"

    # --------------------------------------------------------------------------
    # Agent discovery — RFC 8288
    # --------------------------------------------------------------------------
    Header always set Link "<https://schooloffreelancing.com/.well-known/api-catalog>; rel=\"api-catalog\", <https://schooloffreelancing.com/service-desc>; rel=\"service-doc\", <https://schooloffreelancing.com/.well-known/oauth-protected-resource/mcp>; rel=\"oauth-protected-resource\", <https://schooloffreelancing.com/.well-known/oauth-authorization-server>; rel=\"oauth-authorization-server\""

</IfModule>

# ==============================================================================
# 5. GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>

# ==============================================================================
# 6. SPECIAL FILE TYPES
# ==============================================================================

<Files "http-message-signatures-directory">
    ForceType application/json
</Files>

# BEGIN GSC-FIX CANONICAL REDIRECTS
Redirect 301 /resource-center/ai-chatbot /resource-center/guides/ai-chatbot
Redirect 301 /resource-center/automation /resource-center/guides/automation
Redirect 301 /resource-center/docker-containerize /resource-center/guides/docker-containerize
Redirect 301 /resource-center/linux-deployment /resource-center/guides/linux-deployment
Redirect 301 /resource-center/voip-setup /resource-center/guides/voip-setup
# END GSC-FIX CANONICAL REDIRECTS
