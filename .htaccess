DirectoryIndex index.html index.htm index.php

Options -Indexes

# ==============================================================================
# ENCODING & MIME-TYPES (Forces UTF-8 for plain text, llms.txt, HTML, and CSS)
# ==============================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .json .xml

<IfModule mod_headers.c>
    # Explicitly enforce UTF-8 header on plain text files (e.g., llms.txt, llms-full.txt)
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ==============================================================================
    # 1. FIX CANONICAL & DUPLICATE URL ISSUES (Resolves 301 Redirects & Duplicates)
    # ==============================================================================

    # Force HTTPS on Live Server (Cloudflare/CWP) while EXCLUDING localhost
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Remove www (or force non-www) to prevent "Duplicate without user-selected canonical"
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Remove trailing slashes from non-directory requests to prevent duplicate paths
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Redirect direct requests from /index.html to / (prevents duplicate homepage)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]

    # Direct 301 redirect if someone explicitly requests .html extensions
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/
    RewriteRule ^([^/]+)\.html$ /%1 [R=301,L]

    # ==============================================================================
    # 2. ROUTING & SLUG HANDLING
    # ==============================================================================

    # Serve existing files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Extensionless HTML slug routing (e.g. /about maps to about.html behind scenes)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # ==============================================================================
    # 3. PREVENT REDIRECT ERRORS & LOOP PREVENTION
    # ==============================================================================
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# 4. CUSTOM ERROR PAGES (Fixes 404, 403, 5xx GSC Statuses)
# ==============================================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# 5. ROBOTS & CRAWLER HEADERS (Fixes Indexing & Canonical Discovery)
# ==============================================================================
<IfModule mod_headers.c>
    # Ensure crawlers are allowed to discover assets
    Header set X-Robots-Tag "index, follow"

    # Security header to prevent unwanted 403/blocking glitches
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ==============================================================================
# 6. GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
