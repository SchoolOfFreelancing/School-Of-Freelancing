DirectoryIndex index.html index.htm index.php

Options -Indexes

# ==============================================================================
# ENCODING & MIME-TYPES
# ==============================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .json .xml

<IfModule mod_headers.c>
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==============================================================================
    # 1. FIX CANONICAL & DUPLICATE URL ISSUES
    # ==============================================================================
    # NOTE: HTTPS forcing and www removal are handled at the Cloudflare edge.
    #       - Always Use HTTPS (SSL/TLS → Edge Certificates) handles HTTP → HTTPS
    #       - A Redirect Rule (Rules → Redirect Rules) handles www → non-www
    #       This keeps the origin clean and avoids redirect loops.

    # Redirect external requests for /index.html directly to directory root
    # Relative substitution (no leading /) so it works in subdirectories too
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ $1 [R=301,L]

    # Remove trailing slashes from non-directory requests
    # Relative substitution for subdirectory compatibility
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Direct 301 redirect if someone explicitly requests .html extensions (excluding index.html)
    # Relative substitution (no leading /) for subdirectory compatibility
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^/]+)\.html\ HTTP/ [NC]
    RewriteCond %2 !^index$ [NC]
    RewriteRule ^(.*)\.html$ $1 [R=301,L]

    # ==============================================================================
    # 2. ROUTING & SLUG HANDLING
    # ==============================================================================

    # Serve existing files & directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Extensionless HTML slug routing (e.g. /about maps to about.html)
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Fallback to index.html for Single Page Applications / Unmapped paths
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# 3. CUSTOM ERROR PAGES
# ==============================================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# 4. ROBOTS & CRAWLER HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ==============================================================================
# 5. GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

