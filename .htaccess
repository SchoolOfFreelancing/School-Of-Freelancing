DirectoryIndex index.html index.htm index.php

Options -Indexes

# ==============================================================================
# ENCODING & MIME-TYPES
# ==============================================================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .json .xml

<IfModule mod_headers.c>
    <FilesMatch "\.txt$">
        Header set Content-Type "text/plain; charset=utf-8"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ==============================================================================
    # 1. FIX CANONICAL & DUPLICATE URL ISSUES
    # ==============================================================================
    # HTTPS forcing and www removal are handled at the Cloudflare edge.
    #
    # Cloudflare:
    #   - Always Use HTTPS handles HTTP → HTTPS
    #   - Redirect Rule handles www → non-www
    #
    # This keeps the Apache origin free from conflicting canonical redirects.

    # ------------------------------------------------------------------------------
    # Redirect explicit /index.html requests to the directory root
    # ------------------------------------------------------------------------------
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html(?:[?\s]) [NC]
    RewriteRule ^(.*)index\.html$ $1 [R=301,L]

    # ------------------------------------------------------------------------------
    # Remove trailing slash from non-directory requests
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # ------------------------------------------------------------------------------
    # Remove explicit .html extension
    # Excludes index.html because it is handled separately above.
    # ------------------------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^/]+)\.html(?:[?\s]) [NC]
    RewriteCond %2 !^index$ [NC]
    RewriteRule ^(.*)\.html$ $1 [R=301,L]

    # ==============================================================================
    # 2. ROUTING & SLUG HANDLING
    # ==============================================================================

    # ------------------------------------------------------------------------------
    # Serve existing files and directories directly
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ------------------------------------------------------------------------------
    # Extensionless HTML slug routing
    # Example:
    #   /about → /about.html
    # ------------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # ------------------------------------------------------------------------------
    # Fallback to index.html for unmapped paths / SPA routes
    # ------------------------------------------------------------------------------
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]

</IfModule>

# ==============================================================================
# 3. CUSTOM ERROR PAGES
# ==============================================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# 4. ROBOTS & SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>

    # Tell search engines that normal HTML pages are indexable.
    <FilesMatch "\.(html|htm)$">
        Header set X-Robots-Tag "index, follow"
    </FilesMatch>

    # Prevent MIME-type sniffing.
    Header set X-Content-Type-Options "nosniff"

</IfModule>

# ==============================================================================
# 5. GZIP COMPRESSION
# ==============================================================================
<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>

# ==============================================================================
# 6. GZIP COMPRESSION
# ==============================================================================

<Files "http-message-signatures-directory">
    ForceType application/json
</Files>

