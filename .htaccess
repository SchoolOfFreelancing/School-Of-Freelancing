# ============================================================
# School Of Freelancing - Apache .htaccess
# ============================================================

RewriteEngine On

# ============================================================
# 1. CANONICAL DOMAIN
# www -> non-www
# ============================================================

# RewriteCond %{HTTP_HOST} ^www\.schooloffreelancing\.com [NC]
# RewriteRule ^(.*)$ https://schooloffreelancing.com [L,R=301]

RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ============================================================
# 2. ROOT index.html -> /
# ============================================================

RewriteRule ^index\.html$ https://schooloffreelancing.com/ [R=301,L]

# ============================================================
# 3. OLD FLAT HTML URLS -> CURRENT URLS
# ============================================================

RewriteRule ^(tech-support|support|get-support|get_support)\.html$ https://schooloffreelancing.com/client-support/ [R=301,L]
RewriteRule ^training\.html$ https://schooloffreelancing.com/freelancing-training/ [R=301,L]
RewriteRule ^enrollment\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^contact\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^testimonials\.html$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L]
RewriteRule ^about\.html$ https://schooloffreelancing.com/about-us/ [R=301,L]
RewriteRule ^faq\.html$ https://schooloffreelancing.com/resource-center/faqs/ [R=301,L]
RewriteRule ^privacy-policy\.html$ https://schooloffreelancing.com/legal/privacy-policy/ [R=301,L]
RewriteRule ^terms\.html$ https://schooloffreelancing.com/legal/terms-and-conditions/ [R=301,L]

# ============================================================
# 4. LEGACY FOLDER index.html -> FINAL URL
# (targets differ from folder name, so must precede rule 6)
# ============================================================

RewriteRule ^training/index\.html$ https://schooloffreelancing.com/freelancing-training/ [R=301,L]
RewriteRule ^about/index\.html$ https://schooloffreelancing.com/about-us/ [R=301,L]
RewriteRule ^contact/index\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^testimonials/index\.html$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L]
RewriteRule ^tech-support/index\.html$ https://schooloffreelancing.com/client-support/ [R=301,L]

# ============================================================
# 5. DELETED / LEGACY SECTIONS
# ============================================================

RewriteRule ^training/(enroll|oldenroll|enroll1|files)(?:/.*)?$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^training/?$ https://schooloffreelancing.com/freelancing-training/ [R=301,L]

RewriteRule ^tech-support/get-support/?$ https://schooloffreelancing.com/client-support/ [R=301,L]
RewriteRule ^tech-support/?$ https://schooloffreelancing.com/client-support/ [R=301,L]

RewriteRule ^get-started/?$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^about/?$ https://schooloffreelancing.com/about-us/ [R=301,L]
RewriteRule ^contact/?$ https://schooloffreelancing.com/contact-us/ [R=301,L]
RewriteRule ^testimonials/?$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L]

# ============================================================
# 6. GENERIC index.html -> FOLDER/
# Catches remaining /some-folder/index.html -> /some-folder/
# ============================================================

RewriteRule ^(.+)/index\.html$ https://schooloffreelancing.com/$1/ [R=301,L]

# ============================================================
# 7. STATIC ASSET CACHING
# ============================================================

<IfModule mod_expires.c>

    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # CSS / JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Fonts
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

</IfModule>

# ============================================================
# 8. HTTP RESPONSE HEADERS
# ============================================================

<IfModule mod_headers.c>

    # --------------------------------------------------------
    # AI / Agent Discovery
    # RFC 8288 Link headers
    # --------------------------------------------------------

    Header always add Link "</llms.txt>; rel=\"service-doc\""
    Header always add Link "</.well-known/api-catalog>; rel=\"api-catalog\""

    # --------------------------------------------------------
    # WebMCP Origin Trial
    # https://developer.chrome.com/origintrials/#/view_trial/4163014905550602241
    # --------------------------------------------------------

  Header always set Origin-Trial "AjBt18ONfDupOHO+pn5N5Fzf5r231ixB2m2fG7gCQ94DyFVs2b7zYhUpWWNkH3r/xud7NgDh4CzH2C3fAsAAAByeyJvcmlnaW4iOiJodHRwczovL3NjaG9vbG9mZnJlZMyIsImZlYXR1cmUiOiJJbnN0YWxsRWxlbWVudCIsImV4cGlyeSI6MTc5MTI0NDgwMCwiaXNTdWJkb21haW4iOnRydWV9"
    # --------------------------------------------------------
    # Static assets
    # One-year browser cache
    # --------------------------------------------------------

    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # --------------------------------------------------------
    # HTML
    # Five-minute browser cache
    # --------------------------------------------------------

    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>

</IfModule>

# ============================================================
# 9. CUSTOM 404 PAGE
# ============================================================

ErrorDocument 404 /404.html

# ============================================================
# 10. Tell Googlebot Not to Index robots.txt
# ============================================================
<Files "robots.txt">
    Header set X-Robots-Tag "noindex, nofollow"
</Files>

# ============================================================
# 11. Enabling Gzip Compression
# ============================================================
<IfModule mod_deflate.c>
    # Compression
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml image/x-icon
    
    # Bug Handle
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0 no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>
