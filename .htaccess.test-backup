```apache
# ==========================================================================
# School Of Freelancing - Production .htaccess
# Apache 2.4+
# ==========================================================================

# ----------------------------------------------------------------------
# 0. BASIC SETTINGS
# ----------------------------------------------------------------------

RewriteEngine On
Options -Indexes


# ----------------------------------------------------------------------
# 1. PRODUCTION CANONICAL REDIRECTS
# ----------------------------------------------------------------------
#
# IMPORTANT:
# These redirects apply ONLY to:
#   schooloffreelancing.com
#   www.schooloffreelancing.com
#
# localhost and 127.0.0.1 are NOT redirected to production.
#

# HTTP -> HTTPS for production domain
RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://schooloffreelancing.com%{REQUEST_URI} [R=301,L,NE]

# WWW -> non-WWW for production domain
RewriteCond %{HTTP_HOST} ^www\.schooloffreelancing\.com$ [NC]
RewriteRule ^ https://schooloffreelancing.com%{REQUEST_URI} [R=301,L,NE]


# ----------------------------------------------------------------------
# 2. STRIP index.html
# ----------------------------------------------------------------------
#
# Uses relative redirects so localhost remains localhost.
#

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

# /folder/index.html -> /folder/
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html(?:[?\s]) [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L,NE]


# ----------------------------------------------------------------------
# 3. LEGACY PAGE & SECTION 301 REDIRECTS
# ----------------------------------------------------------------------
#
# These redirects are production-only.
# Localhost will NOT be sent to schooloffreelancing.com.
#

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^(tech-support|support|get-support|get_support)\.html$ https://schooloffreelancing.com/client-support/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^training\.html$ https://schooloffreelancing.com/freelancing-training/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^enrollment\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^contact\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^testimonials\.html$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^about\.html$ https://schooloffreelancing.com/about-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^faq\.html$ https://schooloffreelancing.com/resource-center/faqs/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^privacy-policy\.html$ https://schooloffreelancing.com/legal/privacy-policy/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^terms\.html$ https://schooloffreelancing.com/legal/terms-and-conditions/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^sitemap\.html$ https://schooloffreelancing.com/sitemap/ [R=301,L,NE]


# ----------------------------------------------------------------------
# 4. SUB-FOLDER LEGACY REDIRECTS
# ----------------------------------------------------------------------

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^training/index\.html$ https://schooloffreelancing.com/freelancing-training/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^about/index\.html$ https://schooloffreelancing.com/about-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^contact/index\.html$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^testimonials/index\.html$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^tech-support/index\.html$ https://schooloffreelancing.com/client-support/ [R=301,L,NE]


# Legacy training URLs
RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^training/(enroll|oldenroll|enroll1|files)(/.*)?$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]


# Legacy section URLs
RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^training/?$ https://schooloffreelancing.com/freelancing-training/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^tech-support/get-support/?$ https://schooloffreelancing.com/client-support/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^tech-support/?$ https://schooloffreelancing.com/client-support/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^get-started/?$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^about/?$ https://schooloffreelancing.com/about-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^contact/?$ https://schooloffreelancing.com/contact-us/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?schooloffreelancing\.com$ [NC]
RewriteRule ^testimonials/?$ https://schooloffreelancing.com/resource-center/testimonials/ [R=301,L,NE]


# ----------------------------------------------------------------------
# 5. CLEAN URL HANDLING
# ----------------------------------------------------------------------

# Redirect direct /page.html -> /page
#
# Keep /404.html available for ErrorDocument.
# Relative redirect keeps localhost local.
#

RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]


# ----------------------------------------------------------------------
# 6. INTERNAL HTML ROUTING
# ----------------------------------------------------------------------
#
# /page -> /page.html
# /folder/page -> /folder/page.html
#
# No external redirect occurs.
#

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [END]


# ----------------------------------------------------------------------
# 7. EXPIRES / BROWSER CACHING
# ----------------------------------------------------------------------

<IfModule mod_expires.c>

    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS / JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

</IfModule>


# ----------------------------------------------------------------------
# 8. SECURITY HEADERS & CACHE CONTROL
# ----------------------------------------------------------------------

<IfModule mod_headers.c>

    # ------------------------------------------------------------------
    # HSTS - PRODUCTION ONLY
    # ------------------------------------------------------------------
    #
    # Do NOT send HSTS to localhost.
    #

    SetEnvIf Host "^(.+\.)?schooloffreelancing\.com$" IS_PRODUCTION=1

    Header always set Strict-Transport-Security \
        "max-age=31536000; includeSubDomains" \
        env=IS_PRODUCTION


    # ------------------------------------------------------------------
    # SECURITY HEADERS
    # ------------------------------------------------------------------

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Permissions-Policy \
        "geolocation=(), microphone=(), camera=()"


    # ------------------------------------------------------------------
    # AI / MACHINE-READABLE RESOURCE DISCOVERY
    # ------------------------------------------------------------------

    Header always add Link \
        "</llms.txt>; rel=\"service-doc\""

    Header always add Link \
        "</.well-known/api-catalog>; rel=\"api-catalog\""


    # ------------------------------------------------------------------
    # STATIC ASSET CACHE
    # ------------------------------------------------------------------

    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>


    # ------------------------------------------------------------------
    # HTML CACHE
    # ------------------------------------------------------------------

    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>


    # ------------------------------------------------------------------
    # XML / TXT / JSON CACHE
    # ------------------------------------------------------------------

    <FilesMatch "\.(xml|txt|json)$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>

</IfModule>


# ----------------------------------------------------------------------
# 9. SERVER DEFAULTS
# ----------------------------------------------------------------------

ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

AddType 'text/plain; charset=UTF-8' .txt
AddType 'text/xml; charset=UTF-8' .xml
AddType 'application/json; charset=UTF-8' .json


# ----------------------------------------------------------------------
# 10. GZIP / DEFLATE COMPRESSION
# ----------------------------------------------------------------------

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE \
        text/html \
        text/plain \
        text/xml \
        text/css \
        application/xml \
        application/xhtml+xml \
        application/rss+xml \
        application/javascript \
        application/x-javascript \
        application/json \
        image/svg+xml \
        image/x-icon

</IfModule>


# ==========================================================================
# END OF FILE
# ==========================================================================
```

