{
  "version": "1.0",
  "agents": [
    {
      "id": "sof-agent",
      "name": "School of Freelancing Agent",
      "description": "AI agent for discovering and accessing School of Freelancing training programs, support services, and resources",
      "homepage": "https://schooloffreelancing.com/",
      "documentation": "https://schooloffreelancing.com/auth.md",
      "capabilities": [
        "training-discovery",
        "service-discovery",
        "resource-lookup",
        "mcp-integration"
     ],
      "endpoints": {
        "index": {
          "uri": "https://schooloffreelancing.com/.well-known/agents.json",
          "description": "Agent discovery endpoint"
        },
        "a2a": {
          "uri": "https://schooloffreelancing.com/api/agents/a2a",
          "methods": [
            "POST"
          ],
          "description": "Agent-to-agent protocol endpoint",
          "contentType": "application/json"
        },
        "mcp": {
          "uri": "https://schooloffreelancing.com/api/agents/mcp",
          "methods": [
            "POST"
          ],
          "description": "Model Context Protocol endpoint",
          "contentType": "application/json"
        },
        "skills": {
          "uri": "https://schooloffreelancing.com/.well-known/skills.json",
          "methods": [
            "GET"
          ],
          "description": "Agent skills discovery index",
          "contentType": "application/json"
        },
        "mcp-config": {
          "uri": "https://schooloffreelancing.com/.well-known/mcp.json",
          "methods": [
            "GET"
          ],
          "description": "MCP server configuration and capabilities",
          "contentType": "application/json"
        },
        "webmcp": {
          "uri": "https://schooloffreelancing.com/.well-known/webmcp.json",
          "methods": [
            "GET"
          ],
          "description": "Web-based MCP configuration",
          "contentType": "application/json"
        },
        "llms": {
          "uri": "https://schooloffreelancing.com/llms.txt",
          "methods": [
            "GET"
          ],
          "description": "LLM-friendly site overview",
          "contentType": "text/plain"
        },
        "llms-full": {
          "uri": "https://schooloffreelancing.com/llms-full.txt",
          "methods": [
            "GET"
          ],
          "description": "Complete LLM site content index",
          "contentType": "text/plain"
        }
      },

    }
  ]
}
